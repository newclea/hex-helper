{
  "schema_version": 1,
  "phase": "phase1-connected-pipeline",
  "product_version": "0.1.0",
  "consumed_by_cli": false,
  "note": "Reference manifest for connected Phase1 defaults; runtime configuration is passed through CLI flags.",
  "features": {
    "capture": "windows_graphics_capture_connected",
    "replay": "image_directory_manifest_connected",
    "detector": "fixed_16_by_9_three_card_connected",
    "vision": "windows_media_ocr_zh_CN_connected",
    "matching": "mode_aware_exact_normalized_fuzzy_connected",
    "consensus": "stable_detector_and_same_id_cross_frame_connected",
    "storage": "json_sqlite_jsonl_debug_artifacts_connected",
    "icon_matcher": "unavailable_no_templates"
  },
  "cli_defaults": {
    "mode": "KIWI",
    "knowledge": "data/knowledge/augments.zh-CN.json",
    "workspace": "outputs/runtime",
    "max_seconds": 30.0,
    "preview": false,
    "once": false,
    "selected": null
  },
  "capture": {
    "live_backend": "windows_graphics_capture",
    "window_selection": "visible_top_level_window",
    "capture_item_factory": "IGraphicsCaptureItemInterop::CreateForWindow",
    "cpu_transfer": "D3D11_USAGE_STAGING",
    "queue_capacity": 3,
    "overflow_policy": "drop_oldest",
    "terminal_failure_state": "failed"
  },
  "detector": {
    "aspect_ratio": "16:9",
    "aspect_ratio_relative_tolerance": 0.002,
    "required_consecutive_frames": 3,
    "minimum_frame_confidence": 0.62,
    "offer_roi": { "x": 0.1, "y": 0.1, "width": 0.8, "height": 0.8 },
    "card_rois": [
      { "slot": "LEFT", "x": 0.15, "y": 0.2, "width": 0.2, "height": 0.55 },
      { "slot": "CENTER", "x": 0.4, "y": 0.2, "width": 0.2, "height": 0.55 },
      { "slot": "RIGHT", "x": 0.65, "y": 0.2, "width": 0.2, "height": 0.55 }
    ]
  },
  "vision": {
    "ocr_backend": "windows_media_ocr:zh-CN",
    "maximum_line_candidates": 8,
    "maximum_line_candidate_bytes": 512,
    "candidate_modes": ["KIWI", "KIWI_JADE"],
    "matcher_order": ["exact", "normalized", "fuzzy"],
    "fuzzy": {
      "maximum_edit_distance": 2,
      "maximum_edit_ratio": 0.25,
      "minimum_length": 4,
      "minimum_score": 0.72,
      "minimum_top1_top2_margin": 0.12
    },
    "same_id_consensus_frames": 2,
    "fuzzy_requires_exact_or_normalized_evidence": true,
    "icon_matcher": { "state": "unavailable", "reason": "template_unavailable" }
  },
  "knowledge": {
    "locale": "zh-CN",
    "record_count": 655,
    "unique_technical_id_count": 655,
    "unique_numeric_id_count": 641,
    "supported_cli_modes": ["KIWI", "KIWI_JADE"]
  },
  "runtime": {
    "workspace": "outputs/runtime",
    "writes_enabled": true,
    "stdout": "json_lines",
    "sqlite": "session.sqlite3",
    "jsonl": "events.jsonl",
    "debug_artifacts": ["RAW.png", "LEFT.png", "CENTER.png", "RIGHT.png", "sidecar.json"],
    "cross_media_power_loss_atomicity": "open"
  },
  "limitations": [
    "no_real_lol_acceptance_dataset",
    "fixed_16_by_9_detector",
    "no_multi_resolution_or_ui_scale_calibration",
    "no_hdr_or_hover_validation",
    "icon_matcher_unavailable"
  ]
}
